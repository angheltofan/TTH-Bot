# TTH gateway settings. Copy to .env for LAN development (.env is ignored by
# Git). On Cloud Run, secrets come from Secret Manager instead — never commit
# real values anywhere.

# Supabase project (the publishable key is public, like in the Flutter app)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# SECRET — shared with the gateway-gemini-token Edge Function (>= 32 chars)
GATEWAY_MINT_SECRET=

# SECRET — device registry JSON:
# {"core2-01":{"token_sha256":"<64 hex>","activity_id":null,"enabled":true}}
TTH_DEVICES=

# Optional
PORT=8080
TRUST_PROXY=
GATEWAY_MINT_URL=
TLS_CERT_FILE=
TLS_KEY_FILE=

# LAN DEVELOPMENT ONLY (device Step 6.2 / 6.3 tests): GEMINI_MODE=fake answers
# Gemini locally — no Gemini, no token mint, no mint secret, no Supabase needed
# (the built-in dev activity is used when SUPABASE_URL is empty). The "model
# speech" is an echo of the child's captured audio, converted to 24 kHz.
# Refused on Cloud Run and with TRUST_PROXY=1; every FAKE_* setting is refused
# unless GEMINI_MODE=fake.
#   FAKE_GEMINI_SETUP      ok | fail | never                      (default ok)
#   FAKE_RESPONSE_DELAY_MS 0..60000, after the turn ends           (default 300)
#   FAKE_FIRST_RESPONSE_DELAY_MS 0..60000, the first turn only     (default unset)
#   FAKE_ECHO_REPEAT       1..20, times the echo is sent           (default 1)
#   FAKE_CREDIT_HOLD_MS    0..60000, hold returned credit at zero  (default 0)
#   FAKE_VIOLATE_CREDIT    0 | 1, one frame beyond credit per run  (default 0)
GEMINI_MODE=
FAKE_GEMINI_SETUP=
FAKE_RESPONSE_DELAY_MS=
FAKE_FIRST_RESPONSE_DELAY_MS=
FAKE_ECHO_REPEAT=
FAKE_CREDIT_HOLD_MS=
FAKE_VIOLATE_CREDIT=
